{
  "name": "achat",
  "version": "0.1.0",
  "description": "Minimal, private terminal chat for OpenAI-compatible APIs",
  "type": "module",
  "bin": {
    "achat": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
